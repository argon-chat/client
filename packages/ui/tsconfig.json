{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Consumed as source (main/types point at ./src/index.ts), so there are no .d.ts
    // to emit — and asking for them fails anyway, because several inferred types
    // reference @vue/shared internals that cannot be named from outside Vue.
    "declaration": false,
    "declarationMap": false,
    // No baseUrl: it is deprecated in TypeScript 6 and stops working in 7. Since 4.4
    // `paths` resolve relative to the config file, so these mean the same thing they
    // did before — which is why the `ignoreDeprecations` escape hatch is gone too.
    "paths": {
      "@argon/core": ["../core/src"],
      "@argon/core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules"]
}
