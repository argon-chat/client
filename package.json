{
  "name": "argon",
  "private": true,
  "version": "0.0.0",
  "lastBuildTime": "{lastBuildTime}",
  "fullVersion": "{fullVersion}",
  "branch": "{branch}",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:games && vite",
    "build": "bun run build:games && vite build",
    "build:games": "bun run scripts/build-games.ts",
    "build:games:watch": "bun run scripts/build-games.ts --watch",
    "build:packages": "bun run --filter './packages/*' build",
    "sync:legal": "bun run scripts/sync-legal.ts",
    "theme:empty-states": "bun run scripts/theme-empty-states.ts",
    "lottie:empty-states": "bun run scripts/empty-states-lottie.ts",
    "sentry:dashboards": "bun run scripts/sentry/dashboards.ts",
    "validate": "vue-tsc --noEmit -p tsconfig.app.json",
    "validate:locales": "bun run scripts/validate-locales.ts",
    "i18n:tengwar": "node scripts/tengwar/generate.mjs",
    "test": "bun run test:app && bun run test:packages",
    "test:app": "vitest run --maxWorkers=8",
    "test:watch": "vitest",
    "test:packages": "bun test playframe",
    "test:coverage": "bun run scripts/coverage-report.ts"
  },
  "dependencies": {
    "@argon-chat/emojix": "workspace:*",
    "@argon-chat/ion.webcore": "^2.0.0",
    "@argon/assets": "workspace:*",
    "@argon/audio": "workspace:*",
    "@argon/avatar": "workspace:*",
    "@argon/calls": "workspace:*",
    "@argon/core": "workspace:*",
    "@argon/glue": "workspace:*",
    "@argon/i18n": "workspace:*",
    "@argon/inventory": "workspace:*",
    "@argon/media-editor": "workspace:*",
    "@argon/passkey": "workspace:*",
    "@argon/playframe": "workspace:*",
    "@argon/playframe-host": "workspace:*",
    "@argon/playframe-sdk": "workspace:*",
    "@argon/softphone": "workspace:*",
    "@argon/soundfx": "workspace:*",
    "@argon/storage": "workspace:*",
    "@argon/theme": "workspace:*",
    "@argon/ui": "workspace:*",
    "@floating-ui/vue": "^1.1.11",
    "@internationalized/date": "^3.12.3",
    "@mediabunny/aac-encoder": "^1.61.3",
    "@phosphor-icons/vue": "^2.2.1",
    "@radix-icons/vue": "^1.0.0",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "@sentry/vue": "^10.73.0",
    "@tabler/icons-vue": "^3.46.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vueuse/core": "^14.4.0",
    "@vueuse/motion": "^3.0.3",
    "@xsolla/pay-station-sdk": "^0.15.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "dexie": "^4.4.4",
    "grid-layout-plus": "^1.1.1",
    "idb": "^8.0.3",
    "jsbarcode": "^3.12.3",
    "livekit-client": "^2.23.0",
    "lucide-vue-next": "^0.548.0",
    "mediabunny": "^1.61.3",
    "pinia": "^4.0.3",
    "qr-code-styling": "^1.9.2",
    "qrcode-generator": "^1.5.2",
    "reka-ui": "^2.10.1",
    "rxjs": "^7.8.2",
    "superjson": "^2.2.6",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "thumbhash": "^0.1.1",
    "uuid": "^13.0.2",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.40",
    "vue-demi": "^0.14.10",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@intlify/message-compiler": "11.4.8",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/audioworklet": "^0.0.93",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/reactivity": "3.5.40",
    "@vue/test-utils": "^2.4.11",
    "@webgpu/types": "^0.1.44",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "glaemscribe": "1.3.1",
    "happy-dom": "^20.11.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-svg-loader": "^5.1.1",
    "vitest": "5.1.0",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "reka-ui": "^2.10.1",
    "vue": "^3.5.40"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@firebase/util",
    "@parcel/watcher",
    "@sentry/cli",
    "core-js",
    "deasync",
    "esbuild",
