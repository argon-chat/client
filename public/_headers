# Response headers for Cloudflare Pages.
#
# Two groups, and the split is deliberate.
#
# THE ENFORCED ONES are the headers that cannot break a working app: they forbid things this app
# never does. Shipping them enforcing from the first deploy costs nothing.
#
# THE CONTENT SECURITY POLICY IS REPORT-ONLY, and should stay that way until the reports are quiet.
# A CSP is the one header that breaks an application silently — a blocked script is a feature that
# quietly stops existing, with the reason in a console nobody has open. This app loads a third-party
# stylesheet, runs WebAssembly, opens sockets to several hosts, renders a QR code by *fetching* a
# data: URI, and embeds games in iframes; every one of those is a directive that has to be right.
# Report-Only exercises the whole policy against real traffic and blocks nothing.
#
# REPORTS GO TO SENTRY, which the app already uses — `report-uri` below. Without it the policy was
# decorative: Firefox says so outright ("has a Report-Only policy without a report-uri or report-to
# directive; CSP will not block and cannot report violations"), and the only trace of a violation
# was a console message on whichever machine happened to hit it.
#
# BOTH `report-uri` AND `report-to` are sent, which is what Sentry's own documentation asks for.
# The two are not redundant: a browser that understands `report-to` ignores `report-uri` completely,
# and one that does not is the only reason `report-uri` is still here. They name the same endpoint,
# so which one a browser picks changes nothing about where a violation lands.
#
# CRASHES GO SOMEWHERE ELSE. The `default` endpoint below is ours, not Sentry's, and it is what the
# browser uses for the report types nobody configures explicitly — `crash` above all. When a tab is
# killed the JavaScript in it dies at that instant, so Sentry's browser SDK cannot report its own
# death; this report arrives afterwards, from the browser itself. Sentry's `security/` endpoint is
# built to read CSP violations and answers 200 to anything, so pointing crashes there would look
# like it worked and file nothing. Ours turns them into real Sentry issues instead — see
# BrowserReportEndpoints on the server.
#
# To enforce it: watch the reports across real routes — a call, a game in its iframe, the QR code —
# then rename the header to `Content-Security-Policy`. Both may be sent at once during a changeover:
# the browser honours the enforcing one and reports on the other. Expect noise from browser
# extensions injecting scripts into the page; that is not the app violating its own policy.

/*
  # An asset whose Content-Type is wrong is not to be guessed at; that guess is how an uploaded
  # image becomes a script.
  X-Content-Type-Options: nosniff

  # Referrers are useful to our own origin and nobody else's business. `strict-origin-...` also stops
  # a path leaking over the wire when leaving https.
  Referrer-Policy: strict-origin-when-cross-origin

  # Nothing here is meant to be framed. `frame-ancestors` in the CSP below says the same thing to
  # anything modern; this covers what is left.
  X-Frame-Options: DENY

  # The app asks for the microphone and the camera itself, from its own origin — everything else is
  # denied outright so an embedded game cannot ask on its behalf.
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=()

  # Named report destinations. `csp-endpoint` is Sentry's; `default` is ours, and receives every
  # report type that is not routed by name — which is how crashes arrive.
  Reporting-Endpoints: csp-endpoint="https://sentry.argon.gl/api/22/security/?sentry_key=9d074ba73b580b47cdcc16adf72f523d", default="https://api.argon.gl/telemetry/reports"

  # REPORT-ONLY — see the note at the top before enforcing.
  #
  #   script-src      'wasm-unsafe-eval' because the app runs WebAssembly, which is in the boot
  #                   gate's required list. Deliberately NOT 'unsafe-eval': nothing should need it,
  #                   and the reports are how we find out whether something does.
  #                   The sha256 is the theme bootstrap in index.html, which has to be inline to run
  #                   before the first paint. It is SUBSTITUTED AT BUILD TIME by scripts/cspHeaders.ts
  #                   from the emitted file — never edit it here, and never delete the token.
  #                   cloudflareinsights is Pages' own Web Analytics beacon, injected into the
  #                   response by the CDN rather than by this repository. Turning Web Analytics off
  #                   in the dashboard is the other way to satisfy this line.
  #   style-src       'unsafe-inline' is not optional — Vue writes inline styles for every scoped
  #                   rule and transition — and emoji-css is the third-party sheet index.html pulls.
  #   connect-src     data: is not a mistake: qr-code-styling loads the logo in the middle of the QR
  #                   by fetching it, and the bundler inlines that SVG as a data: URI. Listed under
  #                   img-src alone, the QR code silently loses its centre.
  #                   wss: for the realtime socket and for LiveKit's SFU.
  #   xsolla          The payment SDK is bundled from npm, but at runtime it pulls its own fonts,
  #                   styles and images from cdn.xsolla.net, talks to secure.xsolla.com (and the
  #                   sandbox host, which UltimaCheckoutDialog currently hardcodes), and renders the
  #                   card fields in an iframe from there. Report-Only found all of it — none is
  #                   visible in our source. NOT in script-src, deliberately: the SDK loads no
  #                   remote script, so nothing third-party may execute here, and it should stay
  #                   that way.
  #   frame-src       blob: for the playframe host; games themselves are served from this origin.
  #   worker-src      blob: because vite's worker format produces blob-backed workers.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' {{INLINE_SCRIPT_HASHES}} https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://emoji-css.afeld.me https://cdn.xsolla.net; img-src 'self' data: blob: https://*.argon.gl https://*.argon.zone https://cdn.xsolla.net; media-src 'self' blob: https://*.argon.gl; font-src 'self' data: https://emoji-css.afeld.me https://cdn.xsolla.net; connect-src 'self' data: blob: https://*.argon.gl wss://*.argon.gl https://*.argon.zone wss://*.argon.zone https://cloudflareinsights.com https://secure.xsolla.com https://sandbox-secure.xsolla.com https://cdn.xsolla.net https://logs-01.xsolla.com; worker-src 'self' blob:; frame-src 'self' blob: https://secure.xsolla.com https://sandbox-secure.xsolla.com; child-src 'self' blob: https://secure.xsolla.com https://sandbox-secure.xsolla.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; report-uri https://sentry.argon.gl/api/22/security/?sentry_key=9d074ba73b580b47cdcc16adf72f523d; report-to csp-endpoint

# EVERY NAME UNDER /assets CARRIES A CONTENT HASH, so the bytes behind one never change and may be
# kept for as long as a browser is willing to. A returning visitor then re-fetches only what the
# last deploy actually renamed, which is the point of hashing them in the first place.
#
# `Cache-Control` is set in exactly one rule on purpose. Pages JOINS a header set by several
# matching rules with a comma instead of letting the more specific one win, so adding one to `/*`
# as well would send "no-cache, public, max-age=31536000, immutable" and neither half would mean
# what it says. Anything that needs its own caching needs its own non-overlapping rule.
#
# NOT COVERED HERE: the document. Pages answers `/` with `max-age=0, must-revalidate` on its own,
# which is right, but a deep link served through the SPA fallback gets four hours — and a
# four-hour-old document names chunks the last deploy deleted. installStaleBuildRecovery() catches
# that and reloads; closing it at the edge as well takes a Cache Rule on app.argon.gl, since no
# pattern here can name every route the fallback answers.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker is served from the root so it can claim the whole origin, and it must never be
# held by a cache — a stale one keeps serving an old cache strategy long after a deploy.
/media-sw.js
  Cache-Control: no-cache
